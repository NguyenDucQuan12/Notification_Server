# ==============================================================
# Mẫu biến môi trường cho Notification Server.
# Copy thành env/.env.noti (khi dùng docker-compose) hoặc noti_server/src/.env (chạy local).
# Mọi biến đều có giá trị mặc định trong src/config/configs.py, chỉ khai báo khi cần đổi.
# ==============================================================

# --- Ứng dụng ---
ENVIRONMENT=development            # development | staging | production (production: tắt /docs, log JSON)
HOST=0.0.0.0
PORT=1234
ROOT_PATH=                         # Tiền tố đường dẫn khi chạy sau proxy, vd /quan
# ENABLE_DOCS=true                 # Bỏ comment để ép bật/tắt Swagger

# --- Logging ---
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
# LOG_JSON=true

# --- Redis (phải là CÙNG Redis với API server và worker) ---
REDIS_URL=redis://127.0.0.1:6379/0 # docker-compose: redis://redis:6379/0
REDIS_CONNECT_TIMEOUT=2
REDIS_SOCKET_TIMEOUT=3
REDIS_MAX_CONNECTIONS=50           # Pool lệnh ngắn (ticket, replay); hết thì chờ tối đa REDIS_POOL_TIMEOUT
REDIS_POOL_TIMEOUT=5
REDIS_STREAM_SOCKET_TIMEOUT=10     # PHẢI > HUB_BLOCK_MS/1000 + 1

# --- Stream Hub (đọc Redis dùng chung cho mọi WebSocket) ---
HUB_SHARDS=4                       # Số task đọc song song = số kết nối Redis cho XREAD
HUB_BLOCK_MS=1000
STREAM_READ_COUNT=100
HUB_SUBSCRIBER_QUEUE_SIZE=1000     # Hàng đợi mỗi client; đầy => client quá chậm, ngắt 4408
HEARTBEAT_INTERVAL_SECONDS=15
REPLAY_MAX_EVENTS=1000             # Số event cũ tối đa gửi lại khi reconnect (0 = tắt replay)

# --- WebSocket ---
WS_MAX_CONNECTIONS=10000           # Tối đa mỗi process
WS_MAX_CONNECTIONS_PER_USER=10
WS_ALLOWED_ORIGINS=                # vd https://app.example.com,http://localhost:3000 (trống = không kiểm tra)
WS_SEND_TIMEOUT_SECONDS=10
WS_MAX_MESSAGE_SIZE=65536
WS_PING_INTERVAL=20
WS_PING_TIMEOUT=20
GRACEFUL_SHUTDOWN_SECONDS=10

# --- CORS (chỉ cho HTTP /health) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://172.31.99.130
